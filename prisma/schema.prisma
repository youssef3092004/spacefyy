// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
  OWNER
  DEVELOPER
}

enum PaymentMethod {
  CASH
  BANK
  INSTAPAY
  CARD
}

enum ApprovalSource {
  SYSTEM
  USER
}

enum PayrollStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum Language {
  EN
  AR
}

enum SpaceType {
  PRIVATE
  PUBLIC
  DESK
  MEETING
  VIP
  OTHER
}

enum DeviceType {
  PC
  LAPTOP
  PS4_2
  PS4_4
  PS5_2
  PS5_4
  XBOX_ONE
  XBOX_SERIES_S
  XBOX_SERIES_X
  NINTENDO_SWITCH
  VR_HEADSET
  SIMULATOR
  TV
  PROJECTOR
  TABLET
  SMART_BOARD
  SOUND_SYSTEM
  CAMERA
  MICROPHONE
  OTHER
}

enum UnitType {
  TABLE_TENNIS_TABLE
  BILLIARD_TABLE
  GAMING_STATION
  MULTI_PURPOSE_TABLE
  DESK
  SEAT
  SIMULATOR_POD
  VR_POD
  MEETING_SEAT
  LOCKER
  OTHER
}

enum EquipmentType {
  CONTROLLER
  HEADSET
  KEYBOARD
  MOUSE
  STEERING_WHEEL
  JOYSTICK
  FLIGHT_STICK
  PEDALS
  MICROPHONE
  WEBCAM
  PING_PONG
  BILLIARDO
  BOARD_GAME
  OTHER
}

enum PricingType {
  PER_HOUR
  PER_SESSION
  PER_GAME
}

enum PricingMode {
  TIME_RANGE
  PER_HOUR
  FIXED_PRICE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum VisitStatus {
  ACTIVE
  INVOICED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum SessionResourceType {
  SPACE
  DEVICE
  UNIT
  EQUIPMENT
}

enum SessionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  OPEN
  COMPLETED
}

model BusinessSettings {
  id         String @id @default(uuid())
  businessId String @unique

  defaultLanguage      Language @default(EN)
  notificationsEnabled Boolean  @default(true)
  autoApprovePayroll   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  roleId       String?
  name         String
  phone        String   @unique
  email        String   @unique
  password     String
  profileImage String?  @default("https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role                  Role?                  @relation(fields: [roleId], references: [id], onDelete: SetNull)
  userPermissions       UserPermission[]
  businesses            Business[]
  staffProfile          StaffProfile?
  payrolls              Payroll[]
  BranchUserPermissions BranchUserPermission[]
  sessionsCreated       Session[]              @relation("SessionCreatedBy")
  sessionsEnded         Session[]              @relation("SessionEndedBy")
  sessionsCanceled      Session[]              @relation("SessionCanceledBy")
  sessionsDeleted       Session[]              @relation("SessionDeletedBy")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([roleId])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([name])
}

model StaffProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  branchId   String
  baseSalary Float
  hireDate   DateTime
  position   String
  department String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payrolls   Payroll[]
  nationalId NationalId?

  @@index([branchId])
  @@index([branchId, createdAt])
  @@index([position])
  @@index([department])
}

model NationalId {
  id             String       @id @default(uuid())
  number         String       @unique
  frontImage     String
  backImage      String
  staffProfileId String       @unique
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([number])
  @@index([staffProfileId])
}

model BranchUserPermission {
  id           String   @id @default(uuid())
  branchId     String
  userId       String
  permissionId String
  isAllowed    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId, permissionId])
  @@index([isAllowed])
  @@index([branchId])
  @@index([userId])
  @@index([userId, branchId])
  @@index([permissionId])
}

model Payroll {
  id             String @id @default(uuid())
  staffProfileId String

  grossSalary Decimal @db.Decimal(12, 2)
  bonus       Decimal @db.Decimal(12, 2)
  overtime    Decimal @default(0)
  deductions  Decimal @default(0)
  netSalary   Decimal

  method PaymentMethod
  status PayrollStatus @default(PENDING)

  month Int
  year  Int

  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?

  createdAt DateTime @default(now())

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])
  approvedBy   User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([staffProfileId, month, year])
  @@index([status])
  @@index([month, year])
  @@index([approvedById])
  @@index([staffProfileId])
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles                 RolePermission[]
  userPermissions       UserPermission[]
  BranchUserPermissions BranchUserPermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([roleId, permissionId])
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  isAllowed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([isAllowed])
  @@index([userId])
  @@index([permissionId])
}

model Business {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  planId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan             Plan              @relation(fields: [planId], references: [id])
  branches         Branch[]
  businessSettings BusinessSettings?
  storageUsage     StorageUsage?
  customers        Customer[]

  @@index([ownerId])
}

model Branch {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  address     String
  image       String    @default("https://media.istockphoto.com/id/1472933890/vector/no-image-vector-symbol-missing-available-icon-no-gallery-for-this-moment-placeholder.jpg?s=2048x2048&w=is&k=20&c=Qw0wGz-a6BpwFjaoxtkjgsf75C-DeOYs7GFPU8O9z20=")
  isActive    Boolean   @default(true)
  openingTime DateTime?
  closingTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  staffProfiles         StaffProfile[]
  spaces                Space[]
  devices               Device[]
  units                 Unit[]
  equipment             Equipment[]
  BranchUserPermissions BranchUserPermission[]
  visits                Visit[]
  sessions              Session[]
  pricingRules          PricingRule[]
  products              Product[]
  categoryProducts      CategoryProduct[]
  monthlyStats          BranchMonthlyStats[]
  customerBranches      CustomerBranch[]
  orders                Order[]
  invoices              Invoice[]

  @@index([businessId])
  @@index([isActive])
  @@index([createdAt])
}

model BranchMonthlyStats {
  id       String @id @default(uuid())
  branchId String
  month    Int
  year     Int

  newCustomers        Int     @default(0)
  activeCustomers     Int     @default(0)
  totalRevenue        Decimal @default(0) @db.Decimal(12, 2)
  avgSpendPerCustomer Decimal @default(0) @db.Decimal(10, 2)

  recordedAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, month, year])
  @@index([branchId])
  @@index([branchId, year, month])
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiredAt DateTime
  createdAt DateTime @default(now())
}

model Space {
  id              String      @id @default(uuid())
  branchId        String
  name            String
  type            SpaceType
  customTypeLabel String?
  image           String      @default("https://media.istockphoto.com/id/1472933890/vector/no-image-vector-symbol-missing-available-icon-no-gallery-for-this-moment-placeholder.jpg?s=2048x2048&w=is&k=20&c=Qw0wGz-a6BpwFjaoxtkjgsf75C-DeOYs7GFPU8O9z20=")
  capacity        Int
  availableNumber Int         @default(1)
  priceType       PricingType @default(PER_HOUR)
  price           Decimal     @default(0) @db.Decimal(10, 2)
  isActive        Boolean     @default(true)
  isBusy          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean     @default(false)
  deletedBy       String?

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  devices      Device[]
  units        Unit[]
  pricingRules PricingRule[]

  @@index([branchId])
  @@index([branchId, isBusy, isActive])
  @@index([deletedAt])
  @@index([branchId, deletedAt])
  @@index([isDeleted])
  @@index([branchId, isDeleted])
}

model Device {
  id              String      @id @default(uuid())
  branchId        String
  spaceId         String?
  name            String
  type            DeviceType
  customTypeLabel String?
  image           String      @default("https://media.istockphoto.com/id/1472933890/vector/no-image-vector-symbol-missing-available-icon-no-gallery-for-this-moment-placeholder.jpg?s=2048x2048&w=is&k=20&c=Qw0wGz-a6BpwFjaoxtkjgsf75C-DeOYs7GFPU8O9z20=")
  priceType       PricingType @default(PER_HOUR)
  price           Decimal     @default(0) @db.Decimal(12, 2)
  isActive        Boolean     @default(true)
  isBusy          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean     @default(false)
  deletedBy       String?

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  space        Space?        @relation(fields: [spaceId], references: [id])
  pricingRules PricingRule[]

  @@index([branchId])
  @@index([spaceId])
  @@index([branchId, type])
  @@index([branchId, isBusy, isActive])
  @@index([deletedAt])
  @@index([isDeleted])
  @@index([branchId, isDeleted])
  @@index([branchId, isDeleted, deletedAt])
}

model Unit {
  id              String      @id @default(uuid())
  branchId        String
  spaceId         String?
  name            String
  type            UnitType
  customTypeLabel String?
  image           String      @default("https://media.istockphoto.com/id/1472933890/vector/no-image-vector-symbol-missing-available-icon-no-gallery-for-this-moment-placeholder.jpg?s=2048x2048&w=is&k=20&c=Qw0wGz-a6BpwFjaoxtkjgsf75C-DeOYs7GFPU8O9z20=")
  priceType       PricingType @default(PER_HOUR)
  price           Decimal     @default(0) @db.Decimal(10, 2)
  isActive        Boolean     @default(true)
  isBusy          Boolean     @default(false)
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  space        Space?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  pricingRules PricingRule[]

  @@index([branchId])
  @@index([spaceId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([branchId, isActive, isDeleted])
  @@index([branchId, isBusy, isActive, isDeleted])
  @@index([branchId, type, isDeleted])
}

model Equipment {
  id       String @id @default(uuid())
  branchId String

  name            String
  type            EquipmentType
  customTypeLabel String?
  image           String        @default("https://media.istockphoto.com/id/1472933890/vector/no-image-vector-symbol-missing-available-icon-no-gallery-for-this-moment-placeholder.jpg?s=2048x2048&w=is&k=20&c=Qw0wGz-a6BpwFjaoxtkjgsf75C-DeOYs7GFPU8O9z20=")
  priceType       PricingType   @default(PER_HOUR)
  price           Decimal       @default(0) @db.Decimal(10, 2)
  quantity        Int           @default(1)
  isActive        Boolean       @default(true)
  isBusy          Boolean       @default(false)
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  pricingRules PricingRule[]

  @@index([branchId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([branchId, isActive, isDeleted])
  @@index([branchId, isBusy, isActive, isDeleted])
  @@index([branchId, type, isDeleted])
}

model PricingRule {
  id       String @id @default(uuid())
  branchId String
  name     String

  pricingType PricingType

  minDurationMinutes Int?
  maxDurationMinutes Int?

  minPlayers Int?
  maxPlayers Int?

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("EGP")
  priority Int     @default(0)

  isActive    Boolean     @default(true)
  pricingMode PricingMode @default(TIME_RANGE)

  // Target (ONLY ONE should be set)
  spaceId     String?
  deviceId    String?
  unitId      String?
  equipmentId String?

  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  space      Space?             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  device     Device?            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  unit       Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  equipment  Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  visits     Visit[]
  components SessionComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([deviceId])
  @@index([unitId])
  @@index([equipmentId])
  @@index([isActive])
  @@index([pricingType])
  @@index([pricingMode])
  @@index([priority])
  @@index([spaceId, pricingMode])
  @@index([deviceId, pricingMode])
  @@index([unitId, pricingMode])
  @@index([equipmentId, pricingMode])
  @@index([spaceId, isActive])
  @@index([deviceId, isActive])
  @@index([unitId, isActive])
  @@index([equipmentId, isActive])
  @@index([spaceId, isActive, priority])
  @@index([deviceId, isActive, priority])
  @@index([unitId, isActive, priority])
  @@index([equipmentId, isActive, priority])
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  type        PlanType
  description String?

  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("EGP")
  billingInterval BillingInterval @default(MONTHLY)
  trialDays       Int?

  isActive Boolean @default(true)
  isPublic Boolean @default(true)

  maxStaff     Int?
  maxBranches  Int?
  maxSpaces    Int?
  maxDevices   Int?
  maxUnits     Int?
  maxEquipment Int?
  maxUsers     Int?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]

  @@index([isActive])
  @@index([billingInterval])
}

model StorageUsage {
  id         String @id @default(uuid())
  businessId String @unique

  currentBranches  Int @default(0)
  currentSpaces    Int @default(0)
  currentDevices   Int @default(0)
  currentUnits     Int @default(0)
  currentEquipment Int @default(0)
  currentStaff     Int @default(0)
  currentUsers     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  history  StorageUsageHistory[]

  @@index([businessId])
}

model StorageUsageHistory {
  id             String @id @default(uuid())
  storageUsageId String

  branches  Int
  spaces    Int
  devices   Int
  units     Int @default(0)
  equipment Int @default(0)
  staff     Int
  users     Int

  recordedAt DateTime @default(now())

  storageUsage StorageUsage @relation(fields: [storageUsageId], references: [id], onDelete: Cascade)

  @@index([storageUsageId])
  @@index([recordedAt])
}

model Customer {
  id                String    @id @default(uuid())
  businessId        String
  seqNumber         Int
  name              String
  phone             String
  email             String?
  password          String?
  tags              String[]
  notes             String?
  birthday          DateTime?
  isBlocked         Boolean   @default(false)
  blockedReason     String?
  hasDiscount       Boolean   @default(false)
  discountType      String    @default("FLAT")
  discountAmount    Decimal   @default(0) @db.Decimal(10, 2)
  discountStartsAt  DateTime?
  discountEndsAt    DateTime?
  discountStartTime String?
  discountEndTime   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visits           Visit[]
  orders           Order[]
  customerBranches CustomerBranch[]

  @@unique([businessId, seqNumber])
  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@unique([businessId, email, phone])
  @@index([businessId])
  @@index([phone])
  @@index([email])
  @@index([isBlocked])
}

model CustomerBranch {
  id           String    @id @default(uuid())
  customerId   String
  branchId     String
  registeredAt DateTime  @default(now())
  firstVisitAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([customerId, branchId])
  @@index([branchId])
  @@index([customerId])
  @@index([branchId, registeredAt])
}

model Visit {
  id            String       @id @default(uuid())
  branchId      String
  customerId    String
  pricingRuleId String?
  pricingMode   PricingMode?
  totalPrice    Decimal?     @db.Decimal(10, 2)
  startedAt     DateTime
  endedAt       DateTime?

  status VisitStatus

  durationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pricingRule PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  invoice     Invoice?
  sessions    Session[]
  orders      Order[]

  @@index([branchId])
  @@index([customerId])
  @@index([pricingRuleId])
  @@index([branchId, status])
  @@index([branchId, customerId, startedAt])
}

model Invoice {
  id       String  @id @default(uuid())
  visitId  String? @unique
  orderId  String? @unique
  branchId String?

  totalAmount            Decimal @db.Decimal(12, 2)
  discountType           String  @default("FLAT")
  discountAmount         Decimal @default(0) @db.Decimal(10, 2)
  customerDiscountType   String  @default("FLAT")
  customerDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  finalAmount            Decimal @default(0) @db.Decimal(12, 2)

  status    InvoiceStatus @default(UNPAID)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  paidAt    DateTime?

  visit  Visit?  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([branchId])
}

model Session {
  id        String  @id @default(uuid())
  branchId  String
  visitId   String
  bookingId String?

  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?

  totalPrice Decimal       @default(0) @db.Decimal(10, 2)
  currency   String        @default("EGP")
  status     SessionStatus @default(ACTIVE)

  createdById  String
  endedById    String?
  canceledById String?
  deletedById  String?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visit      Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy    User?  @relation("SessionEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  canceledBy User?  @relation("SessionCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  deletedBy  User?  @relation("SessionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  components SessionComponent[]

  @@index([branchId])
  @@index([visitId])
  @@index([status])
  @@index([bookingId])
  @@index([startedAt])
  @@index([createdById])
  @@index([endedById])
  @@index([canceledById])
  @@index([deletedById])
  @@index([deletedAt])
  @@index([branchId, status])
  @@index([branchId, status, deletedAt])
  @@index([visitId, branchId, deletedAt])
}

model SessionComponent {
  id        String @id @default(uuid())
  sessionId String
  branchId  String

  resourceType SessionResourceType
  resourceId   String

  pricingRuleId String?

  priceType  PricingType @default(PER_HOUR)
  unitPrice  Decimal     @db.Decimal(10, 2)
  quantity   Int         @default(0)
  gamesCount Int         @default(0)

  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  totalPrice      Decimal   @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pricingRule PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([branchId])
  @@index([resourceType, resourceId])
  @@index([pricingRuleId])
  @@index([sessionId, resourceType])
  @@index([branchId, resourceType, resourceId])
}

model CategoryProduct {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([name, branchId])
  @@index([branchId])
  @@index([branchId, createdAt])
}

model Product {
  id               String   @id @default(uuid())
  categoryId       String
  branchId         String
  name             String
  description      String?
  sku              String?
  price            Decimal  @db.Decimal(10, 2)
  stock            Int      @default(0)
  image            String?
  isActive         Boolean  @default(true)
  alertIsActivated Boolean  @default(false)
  alertValue       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category CategoryProduct @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@unique([sku, branchId])
  @@index([isActive])
  @@index([categoryId])
  @@index([branchId])
  @@index([createdAt])
  @@index([name])
  @@index([branchId, isActive])
  @@index([branchId, isActive, createdAt])
  @@index([branchId, categoryId])
  @@index([branchId, categoryId, isActive])
}

model Order {
  id                     String      @id @default(uuid())
  visitId                String?
  branchId               String?
  customerId             String?
  number                 Int         @default(1)
  status                 OrderStatus @default(OPEN)
  discountType           String      @default("FLAT")
  discountAmount         Decimal     @default(0) @db.Decimal(10, 2)
  customerDiscountType   String      @default("FLAT")
  customerDiscountAmount Decimal     @default(0) @db.Decimal(10, 2)
  totalPrice             Decimal     @default(0) @db.Decimal(10, 2)
  finalPrice             Decimal     @default(0) @db.Decimal(10, 2)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  visit      Visit?      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  invoice    Invoice?

  @@index([visitId])
  @@index([branchId])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@index([visitId, createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
}
